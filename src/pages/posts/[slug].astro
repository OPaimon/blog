---
import { getCollection, getEntry } from 'astro:content';
import TableOfContents from '../../components/TableOfContents.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';


export async function getStaticPaths() {
	const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);
	return posts.map((post, index) => ({
		// `post.slug` is the normalized identifier used by Astro's content API.
		// ESLint auto-fix wrongly replaced this with `post.id`, which includes
		// the filename (e.g. "feature-showcase.mdx") and causes lookups to fail.
		params: { slug: post.slug },
		props: {
			prevPost: index + 1 < posts.length ? posts[index + 1] : null,
			nextPost: index - 1 >= 0 ? posts[index - 1] : null,
		},
	}));
}

const slug = Astro.params.slug;
const post = await getEntry('blog', slug);
if (!post) {
	throw new Error(`Post not found: ${slug}`);
}

const { prevPost, nextPost } = Astro.props;
const { Content, headings } = await post.render();
---

<BaseLayout title={post.data.title} description={post.data.description}>
	<div class="post-wrap">
		<aside class="post-toc not-prose">
		<TableOfContents headings={headings} />
		</aside>
		<article class="prose prose-lg prose-gray dark:prose-invert">
		<header class="space-y-2">
			<h1 class="m-0 text-2xl font-semibold">{post.data.title}</h1>
			<p class="m-0 text-sm opacity-70">
				<time datetime={post.data.pubDate.toISOString()}>
					{post.data.pubDate.toLocaleDateString('zh-CN')}
				</time>
				{post.data.updatedDate ? (
					<>
						{' · 更新于 '}
						<time datetime={post.data.updatedDate.toISOString()}>
							{post.data.updatedDate.toLocaleDateString('zh-CN')}
						</time>
					</>
				) : null}
			</p>
			{post.data.description ? <p class="m-0 opacity-80">{post.data.description}</p> : null}
			{post.data.tags && post.data.tags.length > 0 && (
				<ul class="m-0 p-0 list-none flex flex-wrap gap-1.5 not-prose" aria-label="文章标签">
					{post.data.tags.map((tag: string) => (
						<li>
							<a
								href={`/tags/${encodeURIComponent(tag)}/`}
								class="text-xs px-2 py-0.5 rounded-full border border-current opacity-60 hover:opacity-100 no-underline"
							>
								{tag}
							</a>
						</li>
					))}
				</ul>
			)}
		</header>
		<Content />
		</article>
	</div>

	{(prevPost || nextPost) && (
		<nav class="flex justify-between gap-4 border-t border-current pt-4 text-sm" aria-label="文章导航">
			<div class="flex-1">
				{prevPost && (
					<a class="group flex flex-col gap-0.5 no-underline hover:underline" href={`/posts/${prevPost.slug}/`}>
						<span class="opacity-50 text-xs">← 上一篇</span>
						<span class="font-medium">{prevPost.data.title}</span>
					</a>
				)}
			</div>
			<div class="flex-1 text-right">
				{nextPost && (
					<a class="group flex flex-col gap-0.5 items-end no-underline hover:underline" href={`/posts/${nextPost.slug}/`}>
						<span class="opacity-50 text-xs">下一篇 →</span>
						<span class="font-medium">{nextPost.data.title}</span>
					</a>
				)}
			</div>
		</nav>
	)}
</BaseLayout>
