---
const { posts } = Astro.props as {
  posts: Array<{
    slug: string;
    data: { title: string; pubDate: string | Date; description?: string };
  }>;
};
function formatDate(d: string | Date) {
  const date = new Date(d);
  return {
    iso: date.toISOString(),
    local: date.toLocaleDateString('zh-CN'),
  };
}
---

{posts.length === 0 ? (
  <p class="m-0 opacity-80">暂时还没有文章。</p>
) : (
  <ul class="m-0 p-0 list-none space-y-3">
    {posts.map(post => {
      const date = formatDate(post.data.pubDate);
      return (
        <li class="leading-relaxed">
          <div>
            <a class="font-semibold no-underline hover:underline" href={`/posts/${post.slug}/`}>
              {post.data.title}
            </a>
            <span class="opacity-70"> — </span>
            <time class="text-sm opacity-70" datetime={date.iso}>
              {date.local}
            </time>
          </div>
          {post.data.description && <div class="text-sm opacity-80">{post.data.description}</div>}
        </li>
      );
    })}
  </ul>
)}
