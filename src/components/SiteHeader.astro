---
const { currentPath } = Astro.props as { currentPath: string };

const links = [
  { href: "/", label: "首页" },
  { href: "/posts/", label: "文章" },
  { href: "/tags/", label: "标签" },
  { href: "/about/", label: "关于" },
];

function isActiveLink(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---



<header class="site-header">
  <div class="site-header-inner">
    <div class="shrink-0">
      <a class="font-semibold no-underline hover:underline" href="/">个人博客</a>
    </div>
    <nav class="flex flex-wrap gap-3 items-center" aria-label="站点导航">
      {links.map((link) => (
        <a
          class="no-underline hover:underline"
          href={link.href}
          aria-current={isActiveLink(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/rss.xml"
        class="no-underline hover:underline opacity-60 hover:opacity-100"
        aria-label="RSS 订阅"
        title="RSS 订阅"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="block">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
        </svg>
      </a>
    </nav>
  </div>
</header>