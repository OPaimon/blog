---
import type { MarkdownHeading } from 'astro';

const { headings } = Astro.props as { headings: MarkdownHeading[] };

// 只取 h2 和 h3
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{toc.length > 1 && (
  <nav aria-label="文章目录" class="toc">
    <p class="m-0 mb-2 text-xs font-semibold uppercase tracking-wider opacity-50">目录</p>
    <ul class="m-0 p-0 list-none space-y-1 text-sm">
      {toc.map(h => (
        <li class={h.depth === 3 ? 'pl-3' : ''}>
          <a
            href={`#${h.slug}`}
            class="block opacity-60 hover:opacity-100 no-underline hover:underline leading-snug py-0.5"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
