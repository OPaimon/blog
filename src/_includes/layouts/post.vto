---
layout: layouts/base.vto
---
<div class="post-wrap">
  {{ if toc.length }}
    <aside class="post-toc not-prose">
      <nav aria-label="文章目录" class="toc">
        <p
          class="m-0 mb-2 text-xs font-semibold uppercase tracking-wider opacity-50"
        >
          目录
        </p>
        <ul class="m-0 p-0 list-none space-y-1 text-sm">
          {{ for item of toc }}
            <li>
              <a
                href="#{{ item.slug }}"
                class="block opacity-60 hover:opacity-100 no-underline hover:underline leading-snug py-0.5"
              >
                {{ item.text }}
              </a>

              {{ if item.children.length }}
                <ul class="m-0 p-0 list-none pl-3 space-y-1">
                  {{ for child of item.children }}
                    <li>
                      <a
                        href="#{{ child.slug }}"
                        class="block opacity-60 hover:opacity-100 no-underline hover:underline leading-snug py-0.5"
                      >
                        {{ child.text }}
                      </a>
                    </li>
                  {{ /for }}
                </ul>
              {{ /if }}
            </li>
          {{ /for }}
        </ul>
      </nav>
    </aside>
  {{ /if }}
  <article class="prose prose-lg prose-gray dark:prose-invert">
    <header class="space-y-2">
      <h1 class="m-0 text-2xl font-semibold">{{ title }}</h1>
      <p class="m-0 text-sm opacity-70">
        <time datetime="{{ date |> date('ATOM') }}">
          {{ date |> date("yyyy-MM-dd") }}
        </time>

        {{ if updatedDate }}
          · 更新于
          <time datetime="{{ updatedDate |> date('ATOM') }}">
            {{ updatedDate |> date("yyyy-MM-dd") }}
          </time>
        {{ /if }}
      </p>

      {{ if description }}
        <p class="m-0 opacity-80">{{ description }}</p>
      {{ /if }}

      {{ if tags && tags.length > 0 }}
        <ul
          class="m-0 p-0 list-none flex flex-wrap gap-1.5 not-prose"
          aria-label="文章标签"
        >
          {{ for tag of tags }}
            <li>
              <a
                href="/tags/{{ tag }}/"
                class="text-xs px-2 py-0.5 rounded-full border border-current opacity-60 hover:opacity-100 no-underline"
              >
                {{ tag }}
              </a>
            </li>
          {{ /for }}
        </ul>
      {{ /if }}
    </header>

    {{ content }}
  </article>
</div>

{{ set posts = search.pages("type=post draft!=true", "date=desc") }}
{{ set currentIndex = posts.findIndex((p) => p.url === url) }}
{{
  set prevPost = currentIndex + 1 < posts.length ? posts[currentIndex + 1] : null
}}
{{ set nextPost = currentIndex - 1 >= 0 ? posts[currentIndex - 1] : null }}

{{ if prevPost || nextPost }}
  <nav
    class="flex justify-between gap-4 border-t border-current pt-4 text-sm"
    aria-label="文章导航"
  >
    <div class="flex-1">
      {{ if prevPost }}
        <a
          class="group flex flex-col gap-0.5 no-underline hover:underline"
          href="{{ prevPost.url }}"
        >
          <span class="opacity-50 text-xs">← 上一篇</span>
          <span class="font-medium">{{ prevPost.title }}</span>
        </a>
      {{ /if }}
    </div>
    <div class="flex-1 text-right">
      {{ if nextPost }}
        <a
          class="group flex flex-col gap-0.5 items-end no-underline hover:underline"
          href="{{ nextPost.url }}"
        >
          <span class="opacity-50 text-xs">下一篇 →</span>
          <span class="font-medium">{{ nextPost.title }}</span>
        </a>
      {{ /if }}
    </div>
  </nav>
{{ /if }}
